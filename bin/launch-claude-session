#!/usr/bin/env python3
"""launch-claude-session — open a REAL Terminal window running an interactive Claude Code
session on the SAME route as the session launching it (learned, never hardcoded), optionally
with a first prompt, and VERIFY it by outcome: STARTED, then REPLIED. macOS only.

Usage:
  launch-claude-session [options] [-- <extra claude args...>]
  launch-claude-session --route-info
  launch-claude-session --help

Options:
  --route auto|inherit|launcher|login
                       auto (default): inside a Claude session, INHERIT its credentials (a
                       normal Anthropic login needs none: plain `claude`); outside any session,
                       the shell's own route variables if set, else the learned launcher, else
                       the login. See "Routes" below.
                       inherit: copy this shell's route/credential variables into the window.
                       launcher: re-run the detected (or learned) launcher program, e.g. a
                       gateway CLI that started this session; it picks its own key.
                       login: plain `claude` on the normal Anthropic login, nothing copied.
  --route-info         print the detected and the learned route; launch nothing
  --lean               --strict-mcp-config (no MCP servers), plus --settings FILE when
                       LAUNCH_CLAUDE_LEAN_SETTINGS is set. Default is FULL: your normal MCP
                       servers, settings and plugins.
  --cwd DIR            directory the session starts in (default: the current directory)
  --plugin-dir DIR     load a plugin from DIR for this session (repeatable)
  --prompt TEXT        first user message, sent automatically (interactive session, not -p)
                       (a prompt starting with '-' must be written --prompt=-TEXT)
  --prompt-file FILE   same, read from FILE
  --label TEXT         banner text shown in the window
  --start-timeout S    seconds to wait for the session to register (default 90)
  --wait-reply S       after start, seconds to wait for the first reply when a prompt was given
                       (default 180; 0 = do not wait)
  --dry-run            print the window command and inherited variable NAMES, open nothing
  -h, --help           show this help and exit (nothing is run, nothing is learned)

Everything after a bare `--` is passed to claude as extra flags (e.g. -- --effort high).

Routes are learned from the process tree: claude's parent is a shell (direct launch) or
another program (a launcher). Each run inside a session records the route — kind, launcher
words, lane host, never a credential — in
  ${CLAUDE_CONFIG_DIR:-~/.claude}/launch-claude-session/launch-route.json  (mode 0600)
so a later call from outside any session (a plain terminal, a scheduled job) can reuse it.

Credentials never appear on a command line, in Terminal history or in output: inherited
values go to a 0600 temp file the window sources and deletes before claude starts.

How it verifies (an opened window proves nothing):
  STARTED   a NEW <config>/sessions/<pid>.json (newer than launch) with this cwd, kind
            interactive, a live pid ON THE OPENED WINDOW'S TTY (so a parallel session in the
            same folder is never mistaken for it) — `STARTED pid=… session=… route=… lane=…`
  REPLIED   that session's transcript gained a REAL assistant reply (API-error records, which
            Claude Code also writes as assistant records, do not count) — the route works
A failure of the window driver itself (e.g. no Automation permission) is shown verbatim.
Exit codes: 0 verified (STARTED, and REPLIED when a reply was awaited) · 1 NOT_STARTED /
NO_REPLY / SESSION_EXITED · 2 usage error, invalid override, or no usable route.

Environment variables read:
  the route/credential set (ANTHROPIC_*, CLAUDE_CODE_USE_*, CLOUD_ML_REGION, OPENAI_*, AWS_*)
  CLAUDE_CONFIG_DIR            Claude Code's config dir (default ~/.claude)
  LAUNCH_CLAUDE_LEAN_SETTINGS  settings file added by --lean (set but missing => exit 2)
  test-only seams, each validated (invalid => exit 2):
  LCS_TEST_ANCESTRY_JSON  file with a process-ancestry list replacing the live process tree
  LCS_TEST_LOGIN_CLEAN    true|false replacing the clean `claude auth status` probe
  LCS_TEST_DRIVER         executable used instead of the sibling run-in-terminal
  LCS_TEST_TTY_MAP        pid:tty[,pid:tty...] replacing the live tty lookup of a session pid
  CLAUDE_CONFIG_DIR, when set, is carried into the window on every route (a path, not a secret).
"""
import argparse
import glob
import importlib
import json
import os
import re
import shlex
import subprocess
import sys
import tempfile
import time

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, HERE)
lr = importlib.import_module('claude_launch_route')  # sibling module, resolved from this file (not PATH)

CONF = os.environ.get('CLAUDE_CONFIG_DIR') or os.path.join(os.path.expanduser('~'), '.claude')
SESSIONS = os.path.join(CONF, 'sessions')
PROJECTS = os.path.join(CONF, 'projects')
LEARNED = os.path.join(CONF, 'launch-claude-session', 'launch-route.json')
POLL_S = 2
ROUTES = ('auto', 'inherit', 'launcher', 'login')


def die(msg: str) -> None:
    print(f'launch-claude-session: {msg}', file=sys.stderr)
    sys.exit(2)


def parse(argv: list[str]) -> tuple[argparse.Namespace, list[str]]:
    extra: list[str] = []
    if '--' in argv:
        i = argv.index('--')
        argv, extra = argv[:i], argv[i + 1:]
    p = argparse.ArgumentParser(prog='launch-claude-session', add_help=False)
    p.add_argument('-h', '--help', action='store_true')
    p.add_argument('--route', default='auto')
    p.add_argument('--route-info', action='store_true')
    p.add_argument('--lean', action='store_true')
    p.add_argument('--cwd', default=os.getcwd())
    p.add_argument('--plugin-dir', action='append', default=[])
    p.add_argument('--prompt')
    p.add_argument('--prompt-file')
    p.add_argument('--label', default='start a Claude Code session')
    p.add_argument('--start-timeout', type=int, default=90)
    p.add_argument('--wait-reply', type=int, default=180)
    p.add_argument('--dry-run', action='store_true')
    p.add_argument('--check-started', nargs=2, metavar=('MARKER', 'CWD'), help=argparse.SUPPRESS)
    try:
        a, unknown = p.parse_known_args(argv)
    except SystemExit:
        die('bad arguments (see --help)')
    if unknown:
        die(f'unknown argument(s): {" ".join(unknown)} (claude flags go after a bare --; see --help)')
    if a.start_timeout <= 0 or a.wait_reply < 0:
        die('--start-timeout must be > 0 and --wait-reply >= 0 (seconds)')
    if a.route not in ROUTES:
        die(f'--route {a.route!r}: expected one of {", ".join(ROUTES)}')
    return a, extra


def detect() -> lr.Route:
    """The live route, or the test seams' fixture route."""
    anc_file = os.environ.get('LCS_TEST_ANCESTRY_JSON')
    login_s = os.environ.get('LCS_TEST_LOGIN_CLEAN')
    if login_s is not None and login_s not in ('true', 'false'):
        die(f'LCS_TEST_LOGIN_CLEAN={login_s!r}: expected true or false')
    if anc_file is not None:
        try:
            with open(anc_file) as fh:
                ancestry = json.load(fh)
        except (OSError, ValueError) as err:
            die(f'LCS_TEST_ANCESTRY_JSON={anc_file!r}: {err}')
    else:
        ancestry = lr.collect_ancestry()
    logged_in = (login_s == 'true') if login_s is not None else lr.probe_login_clean()
    return lr.classify(ancestry, dict(os.environ), logged_in)


def read_learned() -> dict | None:
    try:
        with open(LEARNED) as fh:
            d = json.load(fh)
        return d if isinstance(d, dict) else None
    except (OSError, ValueError):
        return None


def write_learned(route: lr.Route) -> None:
    """Record a USABLE launcher (no credentials) for calls from outside any session. Only a
    wrapper with safe launcher words is recorded: a later direct or unsafe-wrapper run must not
    erase the last good launcher."""
    if route.kind != 'wrapper' or not route.launcher:
        return
    os.makedirs(os.path.dirname(LEARNED), exist_ok=True)
    data = {'kind': route.kind, 'launcher': route.launcher, 'launcher_name': route.launcher_name,
            'lane': route.lane, 'learned_at': time.strftime('%Y-%m-%dT%H:%M:%S%z')}
    tmp = LEARNED + '.tmp'
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, 'w') as fh:
        json.dump(data, fh, indent=1)
    os.chmod(tmp, 0o600)
    os.replace(tmp, LEARNED)


def _tty_name(t: str) -> str:
    return t.strip().removeprefix('/dev/')


def tty_of(pid: int) -> str:
    """The controlling tty of `pid` (e.g. ttys012), '' when none."""
    seam = os.environ.get('LCS_TEST_TTY_MAP')
    if seam is not None:
        try:
            return dict(x.split(':', 1) for x in seam.split(',') if x).get(str(pid), '')
        except ValueError:
            die(f'LCS_TEST_TTY_MAP={seam!r}: expected pid:tty[,pid:tty...]')
    out = subprocess.run(['ps', '-o', 'tty=', '-p', str(pid)], capture_output=True, text=True, check=False,
                         env={**os.environ, 'LC_ALL': 'C'}).stdout.strip()
    return '' if out in ('', '??', '-') else _tty_name(out)


def started_session(marker: float, cwd: str, window_tty: str) -> dict | None:
    """The live interactive session registered after `marker` in `cwd` on `window_tty`, or None.
    No window tty (the driver's no-window pre-check) never matches."""
    want_tty = _tty_name(window_tty)
    if not want_tty:
        return None
    want = os.path.realpath(cwd)
    for f in glob.glob(os.path.join(SESSIONS, '*.json')):
        if os.path.getmtime(f) <= marker:
            continue
        try:
            with open(f) as fh:
                d = json.load(fh)
            if d.get('startedAt', 0) / 1000 <= marker or d.get('kind') != 'interactive':
                continue
            if os.path.realpath(d.get('cwd', '')) != want:
                continue
            os.kill(int(d['pid']), 0)
            if tty_of(int(d['pid'])) != want_tty:
                continue
        except (OSError, ValueError, KeyError, TypeError):  # half-written or dead session file: skip
            continue
        return d
    return None


def transcript_of(cwd: str, session_id: str) -> str:
    return os.path.join(PROJECTS, re.sub(r'[^A-Za-z0-9]', '-', os.path.realpath(cwd)), f'{session_id}.jsonl')


def is_real_reply(rec: dict) -> bool:
    """An assistant record from the model — not one of Claude Code's synthetic API-error records."""
    if rec.get('type') != 'assistant' or rec.get('isApiErrorMessage'):
        return False
    msg = rec.get('message')
    return not (isinstance(msg, dict) and msg.get('model') == '<synthetic>')


def has_reply(path: str) -> bool:
    try:
        with open(path) as fh:
            return any(is_real_reply(json.loads(line)) for line in fh if line.strip())
    except (OSError, ValueError):
        return False


def private_file(prefix: str, text: str) -> str:
    fd, path = tempfile.mkstemp(prefix=prefix)
    os.fchmod(fd, 0o600)
    with os.fdopen(fd, 'w') as fh:
        fh.write(text)
    return path


def launcher_of(route: lr.Route, learned: dict | None) -> list[str] | None:
    if route.kind == 'wrapper' and route.launcher:
        return route.launcher
    if learned and learned.get('kind') == 'wrapper' and learned.get('launcher'):
        words = lr.launcher_words(list(learned['launcher']))   # re-check: the file is user-editable
        return words
    return None


def resolve(a: argparse.Namespace, route: lr.Route, inherited: dict[str, str]) -> tuple[str, list[str] | None]:
    """(mode, launcher words) for the requested route; dies with the fix when unusable."""
    has_creds = lr.has_route(inherited)
    learned = read_learned()
    want = a.route
    if want == 'auto':
        if route.inside_session and route.kind in ('wrapper', 'env'):
            want = 'inherit' if has_creds else 'launcher'
        elif route.inside_session and route.kind == 'login':
            want = 'login'
        elif route.kind == 'env':                                   # outside: the shell's own route first
            want = 'inherit'
        elif not route.inside_session and launcher_of(route, learned):
            want = 'launcher'                                       # then the learned launcher
        elif route.kind == 'login':
            want = 'login'                                          # then the normal login
        else:
            die('no usable route: this shell has no Claude credentials, no launcher was detected or '
                f'learned ({LEARNED}), and a plain `claude` is not logged in — run `claude auth login`, '
                'or call this from inside the session whose route the window should use')
    if want == 'inherit':
        if not has_creds:
            die('--route inherit: this shell has no Claude route variables to inherit (ANTHROPIC_*, '
                'CLAUDE_CODE_USE_*, CLAUDE_CODE_OAUTH_TOKEN)')
        return 'inherit', None
    if want == 'launcher':
        words = launcher_of(route, learned)
        if not words:
            why = 'its words failed the safety check' if route.unsafe_launcher else 'none was detected or learned'
            die(f'--route launcher: no usable launcher ({why}); see --route-info')
        if route.kind != 'wrapper':
            print(f'NOTICE: the calling session was not started by a launcher ({route.kind}); '
                  f'using the learned launcher `{" ".join(words)}`, which picks its own key')
        return 'launcher', words
    seam = os.environ.get('LCS_TEST_LOGIN_CLEAN')
    logged_in = (seam == 'true') if seam is not None else lr.probe_login_clean()
    if route.kind != 'login' and not logged_in:
        die('--route login: a plain `claude` is not logged in (run `claude auth login`)')
    if route.kind in ('wrapper', 'env'):
        print(f'NOTICE: --route login differs from the calling route ({route.kind}); launching on the normal login')
    return 'login', None


def main() -> None:
    a, extra = parse(sys.argv[1:])
    if a.help:
        print(__doc__)
        sys.exit(0)
    if a.check_started:  # the driver's --verify predicate
        sys.exit(0 if started_session(os.path.getmtime(a.check_started[0]), a.check_started[1],
                                      os.environ.get('RIT_WINDOW_TTY', '')) else 1)
    if a.prompt is not None and a.prompt_file:
        die('give --prompt or --prompt-file, not both')
    lean_settings = os.environ.get('LAUNCH_CLAUDE_LEAN_SETTINGS')
    if lean_settings is not None and not os.path.isfile(os.path.expanduser(lean_settings)):
        die(f'LAUNCH_CLAUDE_LEAN_SETTINGS={lean_settings!r} is not a file')
    driver = os.environ.get('LCS_TEST_DRIVER') or os.path.join(HERE, 'run-in-terminal')
    if 'LCS_TEST_DRIVER' in os.environ and not os.access(driver, os.X_OK):
        die(f'LCS_TEST_DRIVER={driver!r} is not executable')

    route = detect()
    if route.inside_session:
        write_learned(route)
    if a.route_info:
        print('route=' + route.line().removeprefix('kind='))
        learned = read_learned()
        print(f'learned: {LEARNED} ' + (f'kind={learned.get("kind")} launcher={" ".join(learned.get("launcher") or []) or "-"} '
                                        f'lane={learned.get("lane")} at={learned.get("learned_at")}' if learned else '(none)'))
        sys.exit(0)

    cwd = os.path.realpath(os.path.expanduser(a.cwd))
    if not os.path.isdir(cwd):
        die(f'--cwd {a.cwd!r} is not a directory')
    for d in a.plugin_dir:
        if not os.path.isdir(os.path.expanduser(d)):
            die(f'--plugin-dir {d!r} is not a directory')
    prompt = a.prompt
    if a.prompt_file:
        try:
            with open(os.path.expanduser(a.prompt_file)) as fh:
                prompt = fh.read()
        except OSError as err:
            die(f'--prompt-file {a.prompt_file!r}: {err.strerror}')
    if not os.access(driver, os.X_OK):
        die(f'missing executable {driver}')

    inherited = {k: v for k, v in os.environ.items() if lr.CREDENTIAL_VARS.match(k)}
    mode, words = resolve(a, route, inherited)
    flags = (['--strict-mcp-config'] if a.lean else []) \
        + (['--settings', os.path.realpath(os.path.expanduser(lean_settings))] if a.lean and lean_settings else []) \
        + [x for d in a.plugin_dir for x in ('--plugin-dir', os.path.realpath(os.path.expanduser(d)))] + extra
    if mode == 'launcher':
        argv = list(words or []) + ['--'] + flags      # a launcher parses its own argv; claude's go after --
        lane = f'launcher:{route.launcher_name or (words or ["?"])[0]}'
    else:
        argv = ['claude'] + flags
        lane = route.lane if mode == 'inherit' else 'anthropic-login'
    # claude reads the prompt as a positional: guard it with -- unless the launcher's own -- already
    # directly precedes it (a prompt starting with '-' would otherwise read as a flag)
    prompt_sep = '' if mode == 'launcher' and not flags else ' --'
    conf_part = f'export CLAUDE_CONFIG_DIR={shlex.quote(os.environ["CLAUDE_CONFIG_DIR"])} && ' if os.environ.get('CLAUDE_CONFIG_DIR') else ''

    if a.dry_run:
        env_part = '. <0600 env file> && rm -f <it> && ' if mode == 'inherit' else ''
        prompt_part = f'{prompt_sep} "$(cat <prompt file>)"' if prompt else ''
        print(f'{env_part}{conf_part}cd {shlex.quote(cwd)} && ' + ' '.join(shlex.quote(x) for x in argv) + prompt_part)
        if mode == 'inherit':
            print('inherits:', ' '.join(sorted(inherited)), f'(lane {lane})')
        sys.exit(0)

    temp_files: list[str] = []
    cmd = f'{conf_part}cd {shlex.quote(cwd)} && ' + ' '.join(shlex.quote(x) for x in argv)
    if prompt:
        temp_files.append(private_file('launch-claude-session-prompt-', prompt))
        cmd += f'{prompt_sep} "$(cat {shlex.quote(temp_files[-1])})"'
    if mode == 'inherit':
        env_file = private_file('launch-claude-session-env-', ''.join(f'export {k}={shlex.quote(v)}\n' for k, v in sorted(inherited.items())))
        temp_files.append(env_file)
        cmd = f'. {shlex.quote(env_file)} && rm -f {shlex.quote(env_file)} && {cmd}'

    fd, marker = tempfile.mkstemp(prefix='launch-claude-session-marker-')
    os.close(fd)
    os.utime(marker)
    temp_files.append(marker)
    verify = f'{shlex.quote(os.path.realpath(__file__))} --check-started {shlex.quote(marker)} {shlex.quote(cwd)}'
    s = None
    drv: subprocess.CompletedProcess[str] | None = None
    window_tty = ''
    try:
        drv = subprocess.run([driver, '--label', a.label, '--timeout', str(a.start_timeout), '--verify', verify, '--command', cmd],
                             capture_output=True, text=True, check=False)
        window_tty = next((ln.split('=', 1)[1] for ln in drv.stdout.splitlines() if ln.startswith('WINDOW_TTY=')), '')
        s = started_session(os.path.getmtime(marker), cwd, window_tty)
    finally:
        # The window deletes the env file when it sources it; a window that never got that far
        # (parse error, early exit, timeout) must not leave credentials on disk.
        for f in temp_files:
            try:
                os.remove(f)
            except OSError:
                pass
    if s is None:
        err = drv.stderr if drv else ''
        early = [ln for ln in err.splitlines() if ln.startswith(('EXITED_EARLY', '  |'))]
        if early:
            print('\n'.join(early))
        elif drv and drv.returncode != 0 and err.strip():
            print(err.rstrip())                                     # the driver's own reason, verbatim
        if drv and drv.returncode == 2:
            sys.exit(2)                                             # a usage error is not a "not started"
        print(f'NOT_STARTED: no new interactive session on this window (tty {window_tty or "unknown"}) '
              f'in {cwd} within {a.start_timeout}s')
        sys.exit(1)
    print(f'STARTED pid={s["pid"]} session={s["sessionId"]} route={mode}{"+lean" if a.lean else ""} lane={lane}')
    if not prompt or a.wait_reply <= 0:
        sys.exit(0)
    path = transcript_of(cwd, s['sessionId'])
    end = time.time() + a.wait_reply
    while time.time() < end:
        if has_reply(path):
            print(f'REPLIED transcript={path}')
            sys.exit(0)
        try:
            os.kill(int(s['pid']), 0)
        except OSError:
            print(f'SESSION_EXITED before a reply (pid {s["pid"]})')
            sys.exit(1)
        time.sleep(POLL_S)
    print(f'NO_REPLY within {a.wait_reply}s — the route or the prompt may have failed (check the window)')
    sys.exit(1)


if __name__ == '__main__':
    main()
